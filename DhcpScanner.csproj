<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LanIPScanner</AssemblyName>
    <RootNamespace>DhcpScanner</RootNamespace>
    <Version>1.4</Version>
    <Product>局域网设备扫描工具</Product>
    <Company>LanIPScanner</Company>
    <Description>用于扫描局域网中的设备和DHCP服务器</Description>
    <Copyright>Copyright © 2026</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 安装版发布配置（仅 dotnet publish 时生效，不影响 dotnet build） -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="图标.png" LogicalName="DhcpScanner.AboutLogo.png" />
  </ItemGroup>

</Project>
